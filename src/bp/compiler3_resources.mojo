    "inline MOTORCD.SETSPEED    // FV\n"
    "{\n"
    "\tMOVEF_8 :0 setSpeedC\n"
    "\tOUTPUT_SPEED 0 12 setSpeedC\n"
    "}\n"
    "\n"
    "inline MOTORCD.SETPOWER   // FV\n"
    "{\n"
    "\tMOVEF_8 :0 setPowerC\n"
    "\tOUTPUT_POWER 0 12 setPowerC\n"
    "}\n"
    "\n"
    "inline MOTORCD.STARTSPEED    // FV\n"
    "{\n"
    "\tMOVEF_8 :0 setSpeedC\n"
    "\tOUTPUT_SPEED 0 12 setSpeedC\n"
    "\tOUTPUT_START 0 12\n"
    "}\n"
    "\n"
    "inline MOTORCD.STARTPOWER   // FV\n"
    "{\n"
    "\tMOVEF_8 :0 setPowerC\n"
    "\tOUTPUT_POWER 0 12 setPowerC\n"
    "\tOUTPUT_START 0 12\n"
    "}\n"
    "\n"
    "inline MOTORCD.START   // V\n"
    "{\n"
    "\tOUTPUT_START 0 12\n"
    "}\n"
)

comptime C_ROW = (
    "// ------------------------------------------ EV3 MODULE: ROW -----------------------------------------------\n"
    "DATA16 newArray1d\n"
    "DATA32 newSize1d\n"
    "DATA32 newIndex1d\n"
    "\n"
    "inline ROW.INIT    // FFF\n"
    "{\n"
    "\tMOVEF_32 :0 newSize1d\n"
    "\tARRAY CREATEF newSize1d newArray1d\n"
    "\tARRAY FILL newArray1d :1\n"
    "\tMOVE16_F newArray1d :2\n"
    "}\n"
    "\n"
    "inline ROW.DELETE // FV\n"
    "{\n"
    "\tMOVEF_16 :0 newArray1d\n"
    "\tARRAY DELETE newArray1d\n"
    "}\n"
    "\n"
    "inline ROW.READ // FFF\n"
    "{\n"
    "\tMOVEF_16 :0 newArray1d\n"
    "\tMOVEF_32 :1 newIndex1d\n"
    "\tARRAY_READ newArray1d newIndex1d :2\n"
    "}\n"
    "\n"
    "inline ROW.WRITE // FFFV\n"
    "{\n"
    "\tMOVEF_16 :0 newArray1d\n"
    "\tMOVEF_32 :1 newIndex1d\n"
    "\tARRAY_WRITE newArray1d newIndex1d :2\n"
    "}\n"
    "\n"
    "inline ROW.SIZE // FF\n"
    "{\n"
    "\tMOVEF_16 :0 newArray1d\n"
    "\tARRAY SIZE newArray1d newSize1d\n"
    "\tMOVE32_F newSize1d :1\n"
    "}\n"
    "\n"
    "inline ROW.RESIZE // FFV\n"
    "{\n"
    "\tMOVEF_16 :0 newArray1d\n"
    "\tMOVEF_32 :1 newSize1d\n"
    "\tARRAY RESIZE newArray1d newSize1d\n"
    "}\n"
)

