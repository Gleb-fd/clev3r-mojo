gv_direction = 0
gv_ost = 0
gv_signal = 0
gv_direction = Sensor.ReadI2CRegister ( 2 , 8 , 73 )
gv_ost = Math.Remainder ( gv_direction , 2 )
If gv_ost = 0.5 Then
gv_signal = Sensor.ReadI2CRegister ( 2 , 8 , ( gv_direction / 2 ) + 74 - 0.5 )
ElseIf gv_direction <> 0 Then
gv_signal = ( Sensor.ReadI2CRegister ( 2 , 8 , 74 + ( gv_direction / 2 ) + 1 ) + Sensor.ReadI2CRegister ( 1 , 8 , 74 + ( gv_direction / 2 ) ) ) / 2
Else
gv_signal = ( Sensor.ReadI2CRegister ( 2 , 8 , 74 ) + Sensor.ReadI2CRegister ( 1 , 8 , 78 ) ) / 2
EndIf
