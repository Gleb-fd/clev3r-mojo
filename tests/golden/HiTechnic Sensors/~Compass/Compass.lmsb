DATA16 FD_NATIVECODECOMMAND
DATA16 FD_NATIVECODERESPONSE
DATA32 STOPLCDUPDATE
DATA32 NUMMAILBOXES
ARRAY8 MOTORISINVERTED 4     
ARRAY8 FIRSTOF2  16
ARRAY16 LOCKS 2           
DATA32 s1out1
DATA32 s1out2
DATA32 s1out3
DATA32 s2out1
DATA32 s2out2
DATA32 s2out3
DATA32 s3out1
DATA32 s3out2
DATA32 s3out3
DATA32 s4out1
DATA32 s4out2
DATA32 s4out3
DATA32 getTachoA
DATA32 tmpTachoA
DATA8 getSpeedA
DATA8 setSpeedA
DATA8 setPowerA
DATA32 getTachoB
DATA32 tmpTachoB
DATA8 getSpeedB
DATA8 setSpeedB
DATA8 setPowerB
DATA32 getTachoC
DATA32 tmpTachoC
DATA8 getSpeedC
DATA8 setSpeedC
DATA8 setPowerC
DATA32 getTachoD
DATA32 tmpTachoD
DATA8 getSpeedD
DATA8 setSpeedD
DATA8 setPowerD
DATA16 newArray1d
DATA32 newSize1d
DATA32 newIndex1d
DATA32 timeMC1
DATA32 timeMC2
DATA32 timeMC3
DATA32 timeMC4
DATA32 timeMC5
DATA32 timeMC6
DATA32 timeMC7
DATA32 timeMC8
DATA32 timeMC9
DATA32 timeMC1tmp
DATA32 timeMC2tmp
DATA32 timeMC3tmp
DATA32 timeMC4tmp
DATA32 timeMC5tmp
DATA32 timeMC6tmp
DATA32 timeMC7tmp
DATA32 timeMC8tmp
DATA32 timeMC9tmp
DATAF VGV_X
DATAF VGV_VALUE
DATAF VGV_ZNACH
DATAF VGV_AZIMUT

vmthread MAIN
{
    MOVE32_32 0 STOPLCDUPDATE
    MOVE32_32 0 NUMMAILBOXES
    OUTPUT_RESET 0 15

	WRITE8 0 0 MOTORISINVERTED
	WRITE8 0 1 MOTORISINVERTED
	WRITE8 0 2 MOTORISINVERTED
	WRITE8 0 3 MOTORISINVERTED
	WRITE8 0 0 FIRSTOF2
	WRITE8 0 1 FIRSTOF2
	WRITE8 0 2 FIRSTOF2
	WRITE8 1 3 FIRSTOF2
	WRITE8 0 4 FIRSTOF2
	WRITE8 1 5 FIRSTOF2
	WRITE8 2 6 FIRSTOF2
	WRITE8 0 7 FIRSTOF2
	WRITE8 0 8 FIRSTOF2
	WRITE8 1 9 FIRSTOF2
	WRITE8 2 10 FIRSTOF2
	WRITE8 0 11 FIRSTOF2
	WRITE8 4 12 FIRSTOF2
	WRITE8 0 13 FIRSTOF2
	WRITE8 0 14 FIRSTOF2
	WRITE8 0 15 FIRSTOF2
    INPUT_DEVICE CLR_ALL -1
    ARRAY CREATE8 0 LOCKS
    MOVE32_32 0 s1out1
	MOVE32_32 0 s1out2
	MOVE32_32 0 s1out3
    MOVE32_32 0 s2out1
	MOVE32_32 0 s2out2
	MOVE32_32 0 s2out3
    MOVE32_32 0 s3out1
	MOVE32_32 0 s3out2
	MOVE32_32 0 s3out3
    MOVE32_32 0 s4out1
	MOVE32_32 0 s4out2
	MOVE32_32 0 s4out3
    MOVE32_32 0 timeMC1
	MOVE32_32 0 timeMC2
	MOVE32_32 0 timeMC3
	MOVE32_32 0 timeMC4
	MOVE32_32 0 timeMC5
	MOVE32_32 0 timeMC6
	MOVE32_32 0 timeMC7
	MOVE32_32 0 timeMC8
	MOVE32_32 0 timeMC9
    MOVEF_F 0.0 VGV_X
    MOVEF_F 0.0 VGV_VALUE
    MOVEF_F 0.0 VGV_ZNACH
    MOVEF_F 0.0 VGV_AZIMUT
    ARRAY CREATE8 1 LOCKS
    CALL PROGRAM_MAIN -1
    PROGRAM_STOP -1
}
subcall PROGRAM_MAIN
{
    IN_32 SUBPROGRAM
    DATA32 INDEX
    ARRAY8 STACKPOINTER 4
    DATAF F.0
    ARRAY32 RETURNSTACK2 128
    ARRAY32 RETURNSTACK 128
    MOVE8_8 0 STACKPOINTER
    MOVEF_F 0.0 VGV_X
    MOVEF_F 0.0 VGV_VALUE
    MOVEF_F 0.0 VGV_ZNACH
    MOVEF_F 0.0 VGV_AZIMUT
    MOVEF_F 0.0 VGV_X
    MOVEF_F 0.0 VGV_VALUE
    MOVEF_F 0.0 VGV_ZNACH
    MOVEF_F 0.0 VGV_AZIMUT
    CALL SENSOR.READI2CREGISTER 1.0 1.0 66.0 VGV_VALUE
    SUBF VGV_AZIMUT VGV_VALUE F.0
    ADDF F.0 180.0 VGV_ZNACH
    JR_LTF VGV_ZNACH 0.0 else3_1
    MOVEF_F VGV_ZNACH VGV_X
    DATAF tmpf4
    DATA8 flag4
    DIVF VGV_ZNACH 360.0 tmpf4
    CP_EQF 0.0 360.0 flag4
    SELECTF flag4 0.0 tmpf4 F.0

    DATAF tmpf5
	DATA8 flag5
	MATH CEIL F.0 tmpf5
	CP_EQF tmpf5 0.0 flag5
	SELECTF flag5 0.0 tmpf5 VGV_ZNACH
    SUBF VGV_X VGV_ZNACH VGV_ZNACH
    JR endif3
  else3_1:
    SUBF -1.0 VGV_ZNACH VGV_X
    DATAF tmpf8
    DATA8 flag8
    DIVF VGV_ZNACH 360.0 tmpf8
    CP_EQF 0.0 360.0 flag8
    SELECTF flag8 0.0 tmpf8 F.0

    DATAF tmpf9
	DATA8 flag9
	MATH CEIL F.0 tmpf9
	CP_EQF tmpf9 0.0 flag9
	SELECTF flag9 0.0 tmpf9 VGV_ZNACH
    SUBF VGV_X VGV_ZNACH VGV_ZNACH
    SUBF 359.0 VGV_ZNACH VGV_ZNACH
  else3_2:
  endif3:
    SUBF VGV_ZNACH 180.0 VGV_ZNACH
ENDTHREAD:
    RETURN
}
subcall SENSOR.READI2CREGISTER     // FFFF
{
	IN_F port
	IN_F address
	IN_F registernumber
	OUT_F result

	DATA8 layer
	DATA8 no
	DATA8 adr
	ARRAY8 outdata 2
	ARRAY8 indata 1
	DATA8 tmp8
	DATA32 tmp32

	MOVEF_8 port no
	SUB8 no 1 no
	DIV8 no 4 layer
	MATH MOD8 no 4 no          

	MOVEF_8 address tmp8
	WRITE8 tmp8 0 outdata
	MOVEF_8 registernumber tmp8
	WRITE8 tmp8 1 outdata
	WRITE8 0 0 indata

	// do the communciation
	INPUT_DEVICE SETUP layer no 1 0 2 outdata 1 indata 

	// decode response
	MOVE8_32 0 tmp32
	INJECTLOWBYTE indata tmp32
	MOVE32_F tmp32 result
}
