gv_gv_k = ""
gv_gv_sa = 0
gv_gv_sb = 0
gv_gv_k = ""
gv_gv_sa = 0
gv_gv_sb = 0
LCD.Clear ()
LCD.Text ( 1 , 0 , 30 , 1 , "Control motors with" )
LCD.Text ( 1 , 0 , 45 , 1 , "directional buttons" )
LCD.Text ( 1 , 0 , 70 , 1 , "Left/Right: Motor A" )
LCD.Text ( 1 , 0 , 85 , 1 , "Up/Down: Motor B" )
while "True"
gv_gv_k = Buttons.Current
gv_gv_sa = 0
gv_gv_sb = 0
If Text.IsSubText ( gv_gv_k , "L" ) then
gv_gv_sa = - 50
elseif Text.IsSubText ( gv_gv_k , "R" ) then
gv_gv_sa = 50
endif
If Text.IsSubText ( gv_gv_k , "U" ) then
gv_gv_sb = - 50
elseif Text.IsSubText ( gv_gv_k , "D" ) then
gv_gv_sb = 50
endif
Motor.StartPower ( "A" , gv_gv_sa )
Motor.StartPower ( "B" , gv_gv_sb )
Program.Delay ( 100 )
Endwhile
