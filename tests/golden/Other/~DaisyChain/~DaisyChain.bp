gv_l = 0
gv_s = 0
gv_m = ""
gv_p = 0
gv_x = 0
gv_y = 0
While "True"
LCD.StopUpdate ()
LCD.Clear ()
LCD.Text ( 1 , 0 , 2 , 1 , "Plug touch sensors to" )
LCD.Text ( 1 , 0 , 14 , 1 , "the daisy chain bricks" )
LCD.Text ( 1 , 0 , 26 , 1 , "to control the motors" )
For gv_l = 1 To 4
For gv_s = 1 To 4
gv_m = Text.GetCharacter ( 64 + gv_s ) + gv_l
gv_p = Sensor.ReadPercent ( gv_s + ( gv_l - 1 ) * 4 )
gv_x = gv_s * 40 - 30
gv_y = gv_l * 20 + 25
If gv_p > 50 Then
LCD.FillRect ( 1 , gv_x , gv_y , 30 , 18 )
LCD.Text ( 1 , gv_x + 2 , gv_y + 5 , 1 , gv_p )
Motor.Start ( gv_m , 50 )
else
LCD.Rect ( 1 , gv_x , gv_y , 30 , 18 )
LCD.Text ( 1 , gv_x + 10 , gv_y + 5 , 1 , gv_p )
Motor.Stop ( gv_m , "true" )
Endif
endfor
endfor
LCD.Update ()
Program.Delay ( 100 )
EndWhile
