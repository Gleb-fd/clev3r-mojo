  @east[45] = 22
  @east[55] = 42
  @east[65] = 39
EndFunction

Function RoadWeight(in number x1, in number y1, in number x2, in number y2, out number w)
  w = 1
  ax = Math.Min(x1, x2)
  ay = Math.Min(y1, y2)
  If y1 = y2 And Math.Abs(x1 - x2) = 1 Then
    w = @east[ax * 10 + ay]
  EndIf
  If x1 = x2 And Math.Abs(y1 - y2) = 1 Then
    w = @south[ax * 10 + ay]
  EndIf
EndFunction
