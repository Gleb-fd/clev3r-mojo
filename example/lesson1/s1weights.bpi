' Координаты: А=1, Б=2, В=3, Г=4, Д=5, Е=6, Ж=7.
' Ключ x*10+y. east: (x,y)-(x+1,y), south: (x,y)-(x,y+1).
Function InitRoadWeights()
  For x = 1 To 7
    For y = 1 To 5
      @east[x * 10 + y] = 1
      @south[x * 10 + y] = 1
    EndFor
  EndFor
  @east[11] = 43
  @south[11] = 17
  @east[21] = 26
  @south[21] = 27
