folder "prjs" "barcode_test"
include "lib"

motion_status = 0
@barcode_travel = 0
@read_max_deg = 3000
@read_speed = 13
@stripe_min = 35
@gx = 7
@gy = 5
Setup(1, 0)
Calibrate(calibrated)
If calibrated = 1 Then
  LCD.Clear()
  LCD.Text(1, 0, 0, 2, "BARCODE")
  LCD.Text(1, 0, 30, 1, "Place before code")
  LCD.Text(1, 0, 50, 1, "Press to read")
  LCD.Update()
  Buttons.Flush()
  Buttons.Wait()
  ReadBarcode(code)
  Motor.Stop("BC", "true")
  LCD.Clear()
  If code >= 0 Then
    LCD.Text(1, 0, 0, 2, "CODE:")
    LCD.Text(1, 80, 0, 2, code)
  Else
    LCD.Text(1, 0, 0, 2, "READ FAIL")
  EndIf
  LCD.Text(1, 0, 30, 1, "status:")
  LCD.Text(1, 80, 30, 1, @motion_status)
  LCD.Text(1, 0, 50, 1, "degrees:")
  LCD.Text(1, 80, 50, 1, @barcode_travel)
  ShowBarcodeDetails()
  LCD.Update()
Else
  LCD.Clear()
  LCD.Text(1, 0, 0, 2, "cal err")
  LCD.Update()
EndIf

include "s1bar"
